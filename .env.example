# ─────────────────────────────────────────────────────────────────────────────
# BlazeUp Automation — environment template
#
# Single merged `blazeup` domain (SA + partner share one API gateway). Copy this
# template to the one config file the framework loads, then edit:
#
#     cp .env.example config/blazeup/.env
#
# The SA/admin actor and the partner actor are distinguished by ADMIN_* / PARTNER_*
# keys — not separate files. NEVER commit real .env files (gitignored: config/*/.env).
# ─────────────────────────────────────────────────────────────────────────────

# ── Shared API gateway ───────────────────────────────────────────────────────
# One API root for both actors. Must NOT equal a UI origin below — settings.py
# rejects that to catch pointing API calls at a UI server.
API_BASE_URL=https://api.stg.blazeup.ai

# ── Admin / SuperAdmin actor (SA endpoints /v1/sa/*) ─────────────────────────
# Drives most setup + all SA-facing tests. The generic settings aliases
# (settings.base_url / test_email / test_password) resolve to these.
ADMIN_BASE_URL=https://stgsa.blazeup.ai
ADMIN_EMAIL=your-sa-user@example.com
ADMIN_PASSWORD=your-password

# ── QA approver (a SECOND SA account) ───────────────────────────────────────
# Partners and deals go through an approval chain that forbids the CREATOR from
# approving its own record. Automation creates as ADMIN_* and approves as ADMIN2_*.
# Must be a different SA user from ADMIN_EMAIL. Without it, every test that approves
# or rejects is reported BLOCKED ("no QA approver configured").
ADMIN2_EMAIL=your-second-sa-user@example.com
ADMIN2_PASSWORD=your-password

# ── Partner actor (partner endpoints /v1/partner/*) ──────────────────────────
# Optional: the current partner-portal tests mint a throwaway partner from the SA
# side, so these are only needed for direct partner-login tests.
PARTNER_BASE_URL=https://stgpartners.blazeup.ai
PARTNER_EMAIL=your-partner-user@example.com
PARTNER_PASSWORD=your-password
# Partner portal 2FA (TOTP). The portal now requires a 6-digit authenticator code
# after email+password. Put the enrolment "setup key" (base32, shown as
# "Can't scan? Enter this key" during Google Authenticator setup) here so the login
# helper can generate codes with pyotp. Leave empty if the account has no 2FA.
PARTNER_TOTP_SECRET=

# ── Tenant provisioning (deal-win TC PARTNER_API_TENANT_PROVISIONING_ATTRIBUTION_002) ─
# Winning a deal provisions a REAL tenant and mails its admin login / confirmation to this
# address — use your own mailbox, not a throwaway. The TC plus-addresses it per run
# (you+prov-<id>@company.com), so the mail server must accept "+" (Google Workspace and
# Outlook do). The TC is SKIPPED (opt-in) while PROVISION_ADMIN_EMAIL is empty.
PROVISION_ADMIN_EMAIL=
PROVISION_ADMIN_FIRST_NAME=
PROVISION_ADMIN_LAST_NAME=
# National format as you dial it locally, e.g. 0987654321.
PROVISION_ADMIN_PHONE=
# ISO 3166-1 alpha-2 (VN, US, ...) — NOT a dial code. Drives the tenant country, the
# admin phone's countryCode and the prospect country together. Default VN.
PROVISION_ADMIN_COUNTRY=VN

# ── Backend source cross-check (optional) ────────────────────────────────────
# Path to a local clone of blazeupai/blazeup-microservice-sa-partners. Used only by
# `make be-coverage` / `make be-drift`, which read the backend SOURCE to answer "which
# endpoints does nobody test?" and "which TCs should I re-run after this deploy?".
# Nothing else needs it — leave empty and the rest of the suite is unaffected. An
# environment variable of the same name overrides this.
BLAZEUP_BE_REPO=

# ── Browser ──────────────────────────────────────────────────────────────────
HEADLESS=true
BROWSER=chromium                 # chromium | firefox | webkit
SLOW_MO=0                        # ms delay between Playwright actions (debugging)
VIEWPORT_WIDTH=1440
VIEWPORT_HEIGHT=900

# ── API timing ───────────────────────────────────────────────────────────────
DEFAULT_RESPONSE_TIME_MS=30000   # warn threshold (ms) for slow API responses

# ── AI failure-triage (utils/ai_triage.py) ───────────────────────────────────
# Post-run tool that reads a run's test.log and classifies WHY each test failed.
#   python -m utils.ai_triage results/run_YYYYMMDD_HHMMSS
# Provider-agnostic: only the selected provider's key is needed.
AI_PROVIDER=gemini               # gemini | groq | ollama
AI_MODEL=gemini-2.0-flash        # gemini-2.0-flash (free) | llama-3.1-8b-instant | qwen2.5 ...
GEMINI_API_KEY=                  # free key: https://aistudio.google.com/apikey
# GROQ_API_KEY=                  # free key: https://console.groq.com/keys
# OLLAMA_BASE_URL=http://localhost:11434   # local, no key (run `ollama serve`)

# ── Partner invite -> activation link (BLAZ7-17) ─────────────────────────────
# activation (default, post-deploy) | temp_password (legacy: invite returns tempPassword).
PARTNER_INVITE_FLOW=activation
# Where tests read the emailed activation token (never in an HTTP response):
#   none (default: token TCs SKIP) | kafka-local (docker exec rpk, local stack) |
#   cmd (run ACTIVATION_LINK_CMD, which prints the latest mail/notification body)
ACTIVATION_LINK_SOURCE=none
ACTIVATION_LINK_CMD=
ACTIVATION_KAFKA_CONTAINER=pta-kafka
ACTIVATION_KAFKA_TOPIC=local.notify.main
# mint (default: SA creates + approves a partner) | env (log in with PARTNER_EMAIL/PASSWORD)
PARTNER_SESSION_SOURCE=mint
